              <calculation class='tableau' formula='(SUM([Total_Billed])-SUM([Total_Cost]))/SUM([Total_Billed])*100' />
            </column>
            <column caption='Revenue in crores' datatype='real' default-format='n&quot;₹&quot;#,##0.00&quot;Cr&quot;;-&quot;₹&quot;#,##0.00&quot;Cr&quot;' name='[Calculation_0914247836024832]' role='measure' type='quantitative'>
