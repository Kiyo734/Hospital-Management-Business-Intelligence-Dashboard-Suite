    <worksheet name='KPI-Gross Profit'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='9'>GROSS PROFIT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main(Admissions)' name='federated.1v6gd7v05g8hoe1burfc810mz5n2' />
          </datasources>
          <datasource-dependencies datasource='federated.1v6gd7v05g8hoe1burfc810mz5n2'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Gross profit 2024' datatype='real' name='[Calculation_0904628326408201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Admission_Date])=2024&#13;&#10;THEN [Total_Billed]-[Total_Cost] END)' />
            </column>
            <column caption='Gross profit 2023' datatype='real' name='[Calculation_0904628326981642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Admission_Date])=2023&#13;&#10;THEN [Total_Billed]-[Total_Cost] END)' />
            </column>
            <column caption='Gross profit Growth %' datatype='real' name='[Calculation_0904628327108619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0904628326408201]-[Calculation_0904628326981642])/ABS([Calculation_0904628326981642])*100' />
            </column>
            <column caption='KPI gross profit text' datatype='string' name='[Calculation_0904628327436300]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0904628327108619]&gt;=0 THEN&#13;&#10;&quot;↑ &quot; +&#13;&#10;STR(ROUND([Calculation_0904628327108619],1))&#13;&#10;+ &quot;% vs Last year&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&quot;↓ &quot; +&#13;&#10;STR(ROUND(ABS([Calculation_0904628327108619]),1))&#13;&#10;+ &quot;% vs Last year&quot;&#13;&#10;END' />
            </column>
            <column caption='Gross profit color' datatype='string' name='[Calculation_0904628328005645]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_0904628327108619]&gt;=0 THEN&#13;&#10;&quot;Good&quot;&#13;&#10;ELSE&#13;&#10;&quot;Bad&quot;&#13;&#10;END' />
            </column>
            <column caption='Gross Profit in crores' datatype='real' default-format='n&quot;₹&quot;#,##0.00&quot;Cr&quot;;-&quot;₹&quot;#,##0.00&quot;Cr&quot;' name='[Calculation_1863401611456514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_1863401611771907]/10000000,2)' />
            </column>
            <column caption='Gross Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1863401611771907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total_Billed])-SUM([Total_Cost])' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Total Revenue' datatype='real' name='[Total_Billed]' role='measure' type='quantitative' />
            <column caption='Total Cost' datatype='real' name='[Total_Cost]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0904628327436300]' derivation='User' name='[usr:Calculation_0904628327436300:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0904628328005645]' derivation='User' name='[usr:Calculation_0904628328005645:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1863401611456514]' derivation='User' name='[usr:Calculation_1863401611456514:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1v6gd7v05g8hoe1burfc810mz5n2].[Action (Department)]'>
            <groupfilter function='level-members' level='[Department]' user:ui-action-filter='[Action6_C96EDCB9EB824894971E0291AF1FCAD2]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
