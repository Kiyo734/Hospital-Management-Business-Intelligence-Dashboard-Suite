    <worksheet name='Profit Margin'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontname='Arial' fontsize='9'>Monthly Gross Profit Margin (%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main(Admissions)' name='federated.1v6gd7v05g8hoe1burfc810mz5n2' />
          </datasources>
          <datasource-dependencies datasource='federated.1v6gd7v05g8hoe1burfc810mz5n2'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Profit Margin %' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_0458225180708872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Total_Billed])-SUM([Total_Cost]))/SUM([Total_Billed])*100' />
            </column>
            <column caption='Margin Status' datatype='string' name='[Calculation_0904628233076736]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0458225180708872]&gt;=35 THEN &quot;On Target&quot;&#13;&#10;ELSE &quot;Below Target&quot; END' />
            </column>
            <column caption='Revenue in crores' datatype='real' default-format='n&quot;₹&quot;#,##0.00&quot;Cr&quot;;-&quot;₹&quot;#,##0.00&quot;Cr&quot;' name='[Calculation_0914247836024832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([Total_Billed])/10000000,2)' />
            </column>
            <column caption='Cost in Crores' datatype='real' default-format='n&quot;₹&quot;#,##0.00&quot;Cr&quot;;-&quot;₹&quot;#,##0.00&quot;Cr&quot;' name='[Calculation_1863401608138753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Round(SUM([Total_Cost])/10000000,2)' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Total Revenue' datatype='real' name='[Total_Billed]' role='measure' type='quantitative' />
            <column caption='Total Cost' datatype='real' name='[Total_Cost]' role='measure' type='quantitative' />
            <column-instance column='[Admission_Date]' derivation='Month' name='[mn:Admission_Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0458225180708872]' derivation='User' name='[usr:Calculation_0458225180708872:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0904628233076736]' derivation='User' name='[usr:Calculation_0904628233076736:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0914247836024832]' derivation='User' name='[usr:Calculation_0914247836024832:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1863401608138753]' derivation='User' name='[usr:Calculation_1863401608138753:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Admission_Date]' derivation='Year' name='[yr:Admission_Date:ok]' pivot='key' type='ordinal' />
