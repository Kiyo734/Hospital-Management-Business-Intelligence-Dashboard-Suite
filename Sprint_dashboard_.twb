      <table>
        <view>
          <datasources>
            <datasource caption='Main(Admissions)' name='federated.1v6gd7v05g8hoe1burfc810mz5n2' />
          </datasources>
          <datasource-dependencies datasource='federated.1v6gd7v05g8hoe1burfc810mz5n2'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Revenue 2024' datatype='real' name='[Calculation_0856248782045195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF YEAR([Admission_Date]) = 2024&#13;&#10;THEN [Total_Billed]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Revenue 2023' datatype='real' name='[Calculation_0856248782196748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF YEAR([Admission_Date]) = 2023&#13;&#10;THEN [Total_Billed]&#13;&#10;END&#13;&#10;)' />
