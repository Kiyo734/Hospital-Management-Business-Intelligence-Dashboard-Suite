            <column aggregation='CountD' caption='Age Group' datatype='string' name='[Calculation_0458225181433865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Age]&lt;=12 THEN &quot;Child (0-12)&quot; ELSEIF [Age]&lt;=18 THEN &quot;Teen (13-18)&quot;&#13;&#10;ELSEIF [Age]&lt;=40 THEN &quot;Adult (19-40)&quot; ELSEIF [Age]&lt;=60 THEN &quot;Middle Age (41-60)&quot; ELSE &quot;Senior (61+)&quot;END' />
            </column>
            <column caption='% of Total' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_1863401630507013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(COUNT([Admission_ID])/TOTAL(COUNT([Admission_ID]))*100,2)'>
                <table-calc ordering-type='Rows' />
