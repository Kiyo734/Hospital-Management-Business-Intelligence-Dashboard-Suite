    <worksheet name='KPI-Total Cost'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='9'>TOTAL COST</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main(Admissions)' name='federated.1v6gd7v05g8hoe1burfc810mz5n2' />
          </datasources>
          <datasource-dependencies datasource='federated.1v6gd7v05g8hoe1burfc810mz5n2'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Current Year Admissions' datatype='integer' name='[Calculation_0856248771592193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF YEAR([Admission_Date]) = 2024&#13;&#10;THEN 1&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Previous Year Admissions' datatype='integer' name='[Calculation_0856248771985410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF YEAR([Admission_Date]) = 2023&#13;&#10;THEN 1&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Admission Growth %' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_0856248772222979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((&#13;&#10;[Calculation_0856248771592193] - [Calculation_0856248771985410]&#13;&#10;)&#13;&#10;/&#13;&#10;[Calculation_0856248771985410]&#13;&#10;* 100,2)' />
            </column>
            <column caption='Admission KPI Text' datatype='string' name='[Calculation_0856248772501508]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0856248772222979] &gt;= 0 THEN&#13;&#10;&quot;↑ &quot; +&#13;&#10;STR(ROUND([Calculation_0856248772222979],1))&#13;&#10;+ &quot;% vs last year&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&quot;↓ &quot; +&#13;&#10;STR(ROUND(ABS([Calculation_0856248772222979]),1))&#13;&#10;+ &quot;% vs last year&quot;&#13;&#10;END' />
            </column>
            <column caption='Cost 2024' datatype='real' name='[Calculation_0904628321558532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Admission_Date])=2024&#13;&#10;THEN [Total_Cost] END)' />
            </column>
            <column caption='Cost 2023' datatype='real' name='[Calculation_0904628321955845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Admission_Date])=2023&#13;&#10;THEN [Total_Cost] END)' />
            </column>
            <column caption='Cost Change %' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_0904628322074630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0904628321558532]-[Calculation_0904628321955845])/[Calculation_0904628321955845]*100' />
            </column>
            <column caption='KPI cost text' datatype='string' name='[Calculation_0904628322340871]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0904628322074630] &lt; 0 THEN&#13;&#10;&quot;↓ &quot; +&#13;&#10;STR(ROUND(ABS([Calculation_0904628322074630]),1))&#13;&#10;+ &quot;% vs Last year&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&quot;↑ &quot; +&#13;&#10;STR(ROUND([Calculation_0904628322074630],1))&#13;&#10;+ &quot;% vs Last year&quot;&#13;&#10;END' />
            </column>
            <column caption='Cost kpi color' datatype='string' name='[Calculation_0904628323807240]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0904628322074630]&lt;= 5 THEN&#13;&#10;&quot;Good&quot;&#13;&#10;ELSE&#13;&#10;&quot;Bad&quot;&#13;&#10;END' />
            </column>
            <column caption='Cost in Crores' datatype='real' default-format='n&quot;₹&quot;#,##0.00&quot;Cr&quot;;-&quot;₹&quot;#,##0.00&quot;Cr&quot;' name='[Calculation_1863401608138753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Round(SUM([Total_Cost])/10000000,2)' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Total Cost' datatype='real' name='[Total_Cost]' role='measure' type='quantitative' />
            <column caption='Admissions' datatype='table' name='[__tableau_internal_object_id__].[Admissions_EDD8BE372F7D4C2F8E8DEAD39257FC74]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[Admissions_EDD8BE372F7D4C2F8E8DEAD39257FC74]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:Admissions_EDD8BE372F7D4C2F8E8DEAD39257FC74:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Department]' derivation='None' name='[none:Department:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0856248772501508]' derivation='User' name='[usr:Calculation_0856248772501508:nk]' pivot='key' type='nominal' />
