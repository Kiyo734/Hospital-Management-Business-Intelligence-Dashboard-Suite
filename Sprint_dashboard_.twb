    <worksheet name='KPI-AVG LOS'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='9'>AVG LENGTH OF STAY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main(Admissions)' name='federated.1v6gd7v05g8hoe1burfc810mz5n2' />
          </datasources>
          <datasource-dependencies datasource='federated.1v6gd7v05g8hoe1burfc810mz5n2'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Avg Length of Stay' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0458225175040000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Length_of_Stay])' />
            </column>
            <column caption='AVG LOS 2024' datatype='real' name='[Calculation_0856248777469958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;IF YEAR([Admission_Date]) = 2024&#13;&#10;THEN [Length_of_Stay]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='AVG LOS 2023' datatype='real' name='[Calculation_0856248777678855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;IF YEAR([Admission_Date]) = 2023&#13;&#10;THEN [Length_of_Stay]&#13;&#10;END&#13;&#10;)' />
